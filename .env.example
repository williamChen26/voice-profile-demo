# 本地填写；不要将 token 提交到 Git。先在 Hugging Face 接受 Community-1 的使用条件。
HF_TOKEN=
# auto 在 CUDA 可用时使用 CUDA，否则 CPU。macOS 默认 CPU，不自动使用 MPS。
DEVICE=auto
ASR_MODEL=large-v3
ASR_LANGUAGE=zh
DATA_DIR=data
MAX_AUDIO_SECONDS=1800
# 以下仅为演示起点，未经过你的录音数据校准，不代表商用阈值。
ACCEPT_THRESHOLD=0.70
REJECT_THRESHOLD=0.45
MIN_SPEECH_SECONDS=3
MIN_ENROLL_SECONDS=10
PYANNOTE_METRICS_ENABLED=0
HF_HUB_DISABLE_TELEMETRY=1
GRADIO_ANALYTICS_ENABLED=False
